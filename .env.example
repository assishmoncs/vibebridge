# VibeBridge Environment Configuration

# Local HTTP port to bind
PORT=3000

# Local host binding (default: 127.0.0.1)
HOST=127.0.0.1

# Default workspace directory path
VIBEBRIDGE_WORKSPACE=/path/to/your/project

# Public HTTPS Tunnel Configuration
# Tunnel Provider: ngrok, direct
ENABLE_TUNNEL=true
TUNNEL_PROVIDER=ngrok

# ngrok Authentication Token (from https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# Permission Policy: prompt, auto_approve_read, auto_approve_all, deny_writes
# - prompt: Asks user to confirm every write & command execution
# - auto_approve_read: Auto-approves reads, prompts for writes & execution
# - auto_approve_all: Automatically approves all actions (headless dev)
# - deny_writes: Strict read-only mode, rejects all writes & commands
PERMISSION_MODE=prompt
